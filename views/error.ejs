<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ошибка</title>
</head>

<body>
    <div class="main-box">
        <div class="main">
            <span>
                <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="#d46cca"
                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path
                        d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </span>
            <h1>Ошибка <%= NumError %></h1>
            <p id="info"><%= TextError%></p>
            <a href="/"><button class="outline-button"><b>Вход</b></button></a>
        </div>
        <img height="459px"
            src="https://images01.nicepage.io/c461c07a441a5d220e8feb1a/c9d1903b449d53c5ad034708/a37107e3-f4c3-65c9-98a9-69b0f78a61c7.jpg"
            alt="">
    </div>
    <footer>
        <div class="footer-line">
            KiwiProject 2026 |
            <text-line>
                <span id="yarndings-chart">KIRILL ANUROV</span>
                <span>Кирилл Ануров</span>
            </text-line>
            | <a href="https://github.com/SasiskaMine/ClassPro">ClassPro</a>
        </div>
    </footer>
</body>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Oswald:wght@200..700&family=Roboto:ital,wght@0,100..900;1,100..900&family=Yarndings+20+Charted&display=swap');

    .outline-button {
        background-color: rgba(52, 6, 86, 0.7);
        border: 2px solid #730fbb;
        border-radius: 15px;
        width: 150px;
        height: 35px;
        color: white;
        font-family: "Roboto", sans-serif;
        transition: background-color ease 0.3s;
    }
    .outline-button:hover {
        background-color: #730fbb;
        border: 2px solid transparent;
    }

    a {
        text-decoration: wavy;
        color: #0f8ea7;
    }

    .footer-line {
        padding: 16px 0;
        font-size: 16px;
        line-height: 34px;
    }

    text-line {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        vertical-align: middle;
    }

    text-line span {
        font-size: 16px;
        line-height: 16px;
    }

    #yarndings-chart {
        font-family: "Yarndings 20 Charted", system-ui;
    }


    footer {
        background-color: rgba(0, 0, 0, 0.5);
        text-align: center;
        width: 100%;
    }

    .main-box {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 15px 50px;
        height: 100%;
    }

    body {
        background-color: #3f0866;
        color: white;
        font-family: "Oswald", sans-serif;
        height: 100vh;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;

    }

    h3 {
        font-family: "Nubito", sans-serif;
    }

    #info {
        font-family: "Roboto", sans-serif;
        font-size: 20px;
        width: 350px;
    }

    .main {
        margin: 5px;

    }
</style>

</html>